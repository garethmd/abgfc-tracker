# Copy to /opt/abgfc/.env on the droplet (mode 600). Never commit the real file.
SITE_ADDRESS=abgfc.example.com          # hostname Caddy serves; must resolve to the droplet
LEGACY_ADDRESS=1.2.3.4.sslip.io         # optional: old hostname, redirected to SITE_ADDRESS
ABGFC_SECRET_KEY=                       # `openssl rand -hex 32`
ABGFC_COACH_USERNAME=coach
ABGFC_COACH_PASSWORD=                   # the club admin's password; change it after first sign-in
IMAGE_TAG=latest

# --- email: invitations and parents' sign-in links -------------------------------
# Until these are set the app logs emails instead of sending them, and invitations
# still work by copying the link out of Settings -> Parents.
# Links in emails use SITE_ADDRESS, so there is nothing to set for that.
ABGFC_EMAIL_BACKEND=resend                        # console | resend | mailgun
ABGFC_EMAIL_API_KEY=                              # the provider's API key
ABGFC_EMAIL_FROM=ABGFC Blues <noreply@abgfc.example.com>
ABGFC_EMAIL_REPLY_TO=                             # a mailbox somebody reads: the From
                                                  # has no MX, so replies to it bounce
# ABGFC_MAILGUN_DOMAIN=abgfc.example.com          # mailgun backend only
