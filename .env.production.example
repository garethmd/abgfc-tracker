# Copy to /opt/abgfc/.env on the droplet (mode 600). Never commit the real file.
SITE_ADDRESS=abgfc.example.com          # hostname Caddy serves; must resolve to the droplet
LEGACY_ADDRESS=1.2.3.4.sslip.io         # optional: old hostname, redirected to SITE_ADDRESS
ABGFC_SECRET_KEY=                       # `openssl rand -hex 32`
ABGFC_COACH_USERNAME=coach
ABGFC_COACH_PASSWORD=                   # the club admin's password; change it after first sign-in
IMAGE_TAG=latest
