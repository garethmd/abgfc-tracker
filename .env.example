# Copy to .env and change the secret + password before running anywhere but localhost.
ABGFC_SECRET_KEY=change-me-to-a-long-random-string
ABGFC_COACH_USERNAME=coach
ABGFC_COACH_PASSWORD=changeme
# ABGFC_DATABASE_URL=sqlite:////absolute/path/to/abgfc.db
# ABGFC_CORS_ORIGINS=["http://localhost:3000"]
# ABGFC_COOKIE_SECURE=true
# Emails (invitations, parents' sign-in links) are logged, not sent, in development:
# look for "[abgfc.email]" in the API output and click the link from there.
# ABGFC_EMAIL_BACKEND=console
# ABGFC_PUBLIC_BASE_URL=http://localhost:3000
