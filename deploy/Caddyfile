# Caddy terminates TLS (automatic Let's Encrypt) and hands everything to Next.js.
# Next proxies /api/* to the API over the compose network; the API has no public port.
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy frontend:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The pre-domain hostname (<ip>.sslip.io) keeps working as a redirect so old links
# and bookmarks land on the canonical address. Set LEGACY_ADDRESS="" to drop it.
{$LEGACY_ADDRESS:http://legacy.invalid} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
